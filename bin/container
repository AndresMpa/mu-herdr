#!/usr/bin/env bash
# Theme-style modal: pick a Docker/Podman/nerdctl container
# and add it as a pane in the current Herdr workspace.
set -u

HERE=$(cd "$(dirname "$0")/.." && pwd)
HOME_DIR=${HOME:-}
CONF="${HERDR_CONFIG_PATH:-$HOME_DIR/.config/herdr/config.toml}"
CONF_DIR=$(dirname "$CONF")
THEMES="$HERE/themes"
[ -d "$THEMES" ] || THEMES="$CONF_DIR/themes"
accent="#84FFFF"
red="#F07178"
fg="#C5C9D6"

load_colors() {
  local pal="$THEMES/deep-ocean.toml"
  [ -f "$THEMES/active" ] && pal="$THEMES/$(tr -d '[:space:]' <"$THEMES/active").toml"
  [ -f "$pal" ] || return 0
  while IFS='=' read -r k v || [ -n "${k:-}" ]; do
    k=$(printf '%s' "$k" | tr -d '[:space:]')
    v=$(printf '%s' "$v" | tr -d '[:space:]' | tr -d '"')
    case $k in
      accent) accent=$v ;;
      red) red=$v ;;
      fg) fg=$v ;;
    esac
  done <"$pal"
}

hex_fg() {
  local h=${1#\#}
  [ ${#h} -eq 6 ] || return 0
  printf '\033[38;2;%d;%d;%dm' $((0x${h:0:2})) $((0x${h:2:2})) $((0x${h:4:2}))
}

rst() { printf '\033[0m'; }

cols=${COLUMNS:-}
[ -n "$cols" ] || cols=$(tput cols 2>/dev/null) || cols=80
[ "$cols" -gt 24 ] || cols=80
maxw=$((cols - 4))
[ "$maxw" -gt 16 ] || maxw=16

clip() {
  printf '%s' "$1" | awk -v m="$maxw" '{ s=$0; if (length(s)>m) s=substr(s,1,m-1)"…"; print s }'
}

save_tty=$(stty -g 2>/dev/null) || save_tty=
stty -echo -icanon 2>/dev/null || true
trap 'printf "\033[?25h"; [ -n "$save_tty" ] && stty "$save_tty"' EXIT

list_rows() {
  python3 <<'PY'
import os, shutil, subprocess, sys

def run(cmd):
    try:
        return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
    except Exception:
        return ""

def has(name):
    return shutil.which(name) is not None

engines = []
seen_bin = set()
for name in ("podman", "docker", "nerdctl"):
    path = shutil.which(name)
    if not path:
        continue
    real = os.path.realpath(path)
    if real in seen_bin:
        continue
    seen_bin.add(real)
    engines.append(name)

if not engines:
    print("x\tinstall docker, podman, or nerdctl\t\t\t")
    sys.exit(0)

any_c = False
seen_c = set()
for eng in engines:
    out = run([eng, "ps", "-a", "--format", "{{.Names}}\t{{.State}}\t{{.Image}}\t{{.ID}}"])
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        name, state = parts[0].strip(), parts[1].strip().lower()
        image = parts[2].strip() if len(parts) > 2 else ""
        cid = (parts[3].strip() if len(parts) > 3 else "")[:12]
        key = cid or ("%s/%s" % (eng, name))
        if key in seen_c or name in seen_c:
            continue
        seen_c.add(key)
        if name:
            seen_c.add(name)
        print("c\t%s\t%s\t%s\t%s" % (eng, name, state, image))
        any_c = True
if not any_c:
    print("x\t(no containers)\t\t\t")
PY
}

load_colors

TMP=$(mktemp)
list_rows >"$TMP" || { rm -f "$TMP"; echo "could not list containers" >&2; exit 1; }

types=()
engines=()
names=()
states=()
extra=()
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  t=$(printf '%s' "$line" | cut -f1)
  e=$(printf '%s' "$line" | cut -f2)
  n=$(printf '%s' "$line" | cut -f3)
  s=$(printf '%s' "$line" | cut -f4)
  x=$(printf '%s' "$line" | cut -f5)
  types+=("$t")
  engines+=("$e")
  names+=("$n")
  states+=("$s")
  extra+=("$x")
done <"$TMP"
rm -f "$TMP"

n=${#types[@]}
[ "$n" -gt 0 ] || { echo "nothing to show"; exit 1; }

i=0
first_sel() {
  local x=0
  while [ "$x" -lt "$n" ]; do
    case ${types[$x]} in
      c) i=$x; return ;;
    esac
    x=$((x + 1))
  done
}
first_sel

move() {
  local dir=$1
  local x=$i
  while true; do
    x=$((x + dir))
    if [ "$x" -lt 0 ]; then
      x=$((n - 1))
    fi
    if [ "$x" -ge "$n" ]; then
      x=0
    fi
    case ${types[$x]} in
      c) i=$x; return ;;
    esac
    [ "$x" -eq "$i" ] && return
  done
}

status=""

draw() {
  local x t mark label
  printf '\033[?25l\033[H'
  printf '\033[K'
  printf '  MμHerdr containers  '
  hex_fg "$accent"
  printf 'j/k'
  rst
  printf '  Enter add  '
  hex_fg "$red"
  printf 'Esc'
  rst
  printf ' cancel\n'
  printf '\033[K'
  if [ -n "$status" ]; then
    printf '  %s\n' "$(clip "$status")"
  else
    printf '\n'
  fi
  x=0
  while [ "$x" -lt "$n" ]; do
    t=${types[$x]}
    printf '\033[K'
    if [ "$t" = s ]; then
      hex_fg "$accent"
      printf '  %s\n' "$(clip "${engines[$x]}")"
      rst
    elif [ "$t" = x ]; then
      hex_fg "$fg"
      printf '    %s\n' "$(clip "${engines[$x]} ${names[$x]}")"
      rst
    else
      label=$(printf '%-8s  %-16s  %-10s  %s' "${engines[$x]}" "${names[$x]}" "${states[$x]}" "${extra[$x]}")
      if [ "$x" -eq "$i" ]; then
        printf '  ❯ %s\n' "$(clip "$label")"
      else
        printf '    %s\n' "$(clip "$label")"
      fi
    fi
    x=$((x + 1))
  done
  printf '\033[J'
}

parse_pane_id() {
  python3 -c '
import json, sys
d = json.load(sys.stdin)
p = (d.get("result") or {}).get("pane") or {}
print(p.get("pane_id") or "")
'
}

add_workspace_pane() {
  local title=$1
  shift
  local json id pane
  pane=${HERDR_ACTIVE_PANE_ID:-}
  if [ -n "$pane" ]; then
    json=$(herdr pane split --pane "$pane" --direction right --focus) || return 1
  else
    json=$(herdr pane split --current --direction right --focus) || return 1
  fi
  id=$(printf '%s' "$json" | parse_pane_id)
  [ -n "$id" ] || return 1
  herdr pane rename "$id" "$title" >/dev/null 2>&1 || true
  herdr pane run "$id" "$@" >/dev/null 2>&1 || return 1
}

do_enter() {
  local t=${types[$i]}
  local eng=${engines[$i]}
  local name=${names[$i]}
  local state=${states[$i]}
  case $t in
    c)
      if [ "$state" != running ]; then
        "$eng" start "$name" >/dev/null 2>&1 || { status="could not start $name"; return; }
      fi
      add_workspace_pane "$eng:$name" "$eng" exec -it "$name" sh -c 'exec bash || exec sh' \
        || { status="could not add $name"; return; }
      ;;
    *)
      return
      ;;
  esac
  exit 0
}

while true; do
  draw
  IFS= read -r -n 1 key || key=
  if [ "$key" = j ]; then
    move 1
  elif [ "$key" = k ]; then
    move -1
  elif [ "$key" = "$(printf '\033')" ] || [ "$key" = q ]; then
    exit 0
  else
    do_enter
  fi
done
