#!/usr/bin/env bash
# List containers via the system runtime (docker, podman, or nerdctl).
# Same UX either way — the engine is auto-detected and hidden from the UI.
# Enter: start if stopped, then open a workspace with an interactive shell.
set -u
printf '\033]0;Containers\007\033]2;Containers\007'

HERE=$(cd "$(dirname "$0")/.." && pwd)
HOME_DIR=${HOME:-}
CONF="${HERDR_CONFIG_PATH:-$HOME_DIR/.config/herdr/config.toml}"
CONF_DIR=$(dirname "$CONF")
HERDR_BIN=${HERDR_BIN_PATH:-herdr}
THEMES="$HERE/themes"
[ -d "$THEMES" ] || THEMES="$CONF_DIR/themes"
LOG="$CONF_DIR/container.log"
accent="#84FFFF"
red="#F07178"
green="#C3E88D"
yellow="#FFCB6B"
fg="#C5C9D6"

ctr_log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG" 2>/dev/null || true
}

load_colors() {
  local pal="$THEMES/deep-ocean.toml"
  [ -f "$THEMES/active" ] && pal="$THEMES/$(tr -d '[:space:]' <"$THEMES/active").toml"
  [ -f "$pal" ] || return 0
  while IFS='=' read -r k v || [ -n "${k:-}" ]; do
    k=$(printf '%s' "$k" | tr -d '[:space:]')
    v=$(printf '%s' "$v" | tr -d '[:space:]' | tr -d '"')
    case $k in
      accent) accent=$v ;;
      red) red=$v ;;
      green) green=$v ;;
      yellow) yellow=$v ;;
      fg) fg=$v ;;
    esac
  done <"$pal"
}

hex_fg() {
  local h=${1#\#}
  [ ${#h} -eq 6 ] || return 0
  printf '\033[38;2;%d;%d;%dm' $((0x${h:0:2})) $((0x${h:2:2})) $((0x${h:4:2}))
}

rst() { printf '\033[0m'; }

cols=${COLUMNS:-}
[ -n "$cols" ] || cols=$(tput cols 2>/dev/null) || cols=80
[ "$cols" -gt 24 ] || cols=80
maxw=$((cols - 4))
[ "$maxw" -gt 16 ] || maxw=16

clip() {
  printf '%s' "$1" | awk -v m="$maxw" '{ s=$0; if (length(s)>m) s=substr(s,1,m-1)"..."; print s }'
}

save_tty=$(stty -g 2>/dev/null) || save_tty=
stty -echo -icanon 2>/dev/null || true
trap 'printf "\033[?25h"; [ -n "$save_tty" ] && stty "$save_tty"' EXIT

list_rows() {
  python3 <<'PY'
import json, os, shutil, subprocess, sys

def run(cmd, timeout=8):
    try:
        return subprocess.check_output(
            cmd, text=True, stderr=subprocess.DEVNULL, timeout=timeout
        )
    except Exception:
        return ""

def short_image(image):
    image = (image or "").strip()
    if not image:
        return "-"
    if "@" in image:
        image = image.split("@", 1)[0]
    base = image.rsplit("/", 1)[-1]
    return base or image

def norm_state(raw):
    s = (raw or "").strip().lower()
    if not s:
        return "unknown"
    if s in ("running", "up") or s.startswith("up ") or "running" in s:
        return "running"
    if s.startswith("exit") or s in ("stopped", "stopping"):
        return "exited"
    if s.startswith("creat"):
        return "created"
    if "pause" in s:
        return "paused"
    if s in ("dead", "removing", "restarting"):
        return s.split()[0]
    # "Up 2 hours", "Exited (0) 3 days ago"
    if s.startswith("up"):
        return "running"
    return s.split()[0] if s.split() else "unknown"

def parse_depends(raw):
    out, seen = [], set()
    for part in (raw or "").split(","):
        part = part.strip()
        if not part:
            continue
        svc = part.split(":", 1)[0].strip()
        if svc and svc not in seen:
            seen.add(svc)
            out.append(svc)
    return out

def meta_from_info(info):
    """volume, dir, project, service, deps — from one inspect object. TSV-safe."""
    vol, directory = "-", "-"
    project, service, deps = "", "", []
    if not info:
        return vol, directory, project, service, deps
    cfg = info.get("Config") or {}
    labels = cfg.get("Labels") or {}
    mounts = info.get("Mounts") or []

    vol_names = []
    bind_srcs = []
    for m in mounts:
        mtype = (m.get("Type") or "").lower()
        if mtype == "volume":
            n = m.get("Name") or ""
            if n:
                n = n.split("_")[-2] + "_" + n.split("_")[-1] if n.count("_") >= 2 else n
                if n not in vol_names:
                    vol_names.append(n)
        elif mtype in ("bind", "bind-mount"):
            src = m.get("Source") or m.get("source") or ""
            if src:
                bind_srcs.append(src)
    if vol_names:
        vol = ",".join(vol_names[:3])
        if len(vol_names) > 3:
            vol += ",+"
    elif bind_srcs:
        base = os.path.basename(bind_srcs[0].rstrip("/")) or "bind"
        vol = "bind:" + base

    directory = (
        labels.get("com.docker.compose.project.working_dir")
        or labels.get("com.docker.compose.project.workingdir")
        or labels.get("io.podman.compose.project.working_dir")
        or cfg.get("WorkingDir")
        or (bind_srcs[0] if bind_srcs else "")
        or "-"
    )
    home = os.path.expanduser("~")
    if directory.startswith(home + os.sep):
        directory = "~" + directory[len(home):]
    directory = directory.replace("\t", " ").replace("\n", " ")
    vol = vol.replace("\t", " ").replace("\n", " ")

    project = (
        labels.get("com.docker.compose.project")
        or labels.get("io.podman.compose.project")
        or ""
    )
    service = (
        labels.get("com.docker.compose.service")
        or labels.get("io.podman.compose.service")
        or ""
    )
    deps = parse_depends(
        labels.get("com.docker.compose.depends_on")
        or labels.get("io.podman.compose.depends_on")
        or ""
    )
    return vol or "-", directory or "-", project, service, deps

def found_bins():
    """Installed runtimes in preference order, deduped by realpath."""
    seen = set()
    out = []
    for name in ("docker", "podman", "nerdctl"):
        path = shutil.which(name)
        if not path:
            continue
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        out.append(name)
    return out

def engine_up(name):
    """True if the runtime answers `ps -a` (daemon/socket up)."""
    try:
        subprocess.check_output(
            [name, "ps", "-a"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )
        return True
    except Exception:
        return False

def pick_engine():
    """One runtime only. Prefer docker, then podman, then nerdctl."""
    for name in found_bins():
        if engine_up(name):
            return name
    return ""

def empty_engine_msg():
    """UI hint when no runtime can list containers."""
    bins = found_bins()
    if not bins:
        return "install docker or podman"
    # CLI present, engine/socket down — any provider (Desktop, Colima, OrbStack, podman machine…).
    return "start " + " or ".join(bins) + " (daemon not running)"

def list_ps(eng):
    """Return list of dicts with name, state, image, id — docker or podman."""
    # 1) JSON array (podman ps --format json; some docker builds)
    raw = run([eng, "ps", "-a", "--format", "json"])
    items = []
    if raw.strip().startswith("["):
        try:
            items = json.loads(raw)
        except Exception:
            items = []
    elif raw.strip().startswith("{"):
        # NDJSON (docker ps --format '{{json .}}' style if user aliased)
        for line in raw.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                items.append(json.loads(line))
            except Exception:
                pass

    rows = []
    if items:
        for it in items:
            names = it.get("Names") or it.get("names") or it.get("Name") or ""
            if isinstance(names, list):
                name = (names[0] if names else "") or ""
            else:
                name = str(names).split(",")[0].strip()
            name = name.lstrip("/")
            state = norm_state(
                it.get("State")
                or it.get("state")
                or it.get("Status")
                or it.get("status")
                or ""
            )
            image = it.get("Image") or it.get("image") or ""
            cid = str(it.get("ID") or it.get("Id") or it.get("id") or "")[:12]
            if name:
                rows.append((name, state, image, cid))
        return rows

    # 2) Go-template fallback (docker + podman)
    for tmpl in (
        "{{.Names}}\t{{.State}}\t{{.Image}}\t{{.ID}}",
        "{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.ID}}",
    ):
        out = run([eng, "ps", "-a", "--format", tmpl])
        if not out.strip():
            continue
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) < 2:
                continue
            name = parts[0].strip().lstrip("/").split(",")[0]
            state = norm_state(parts[1])
            image = parts[2].strip() if len(parts) > 2 else ""
            cid = (parts[3].strip() if len(parts) > 3 else "")[:12]
            if name:
                rows.append((name, state, image, cid))
        if rows:
            break
    return rows

eng = pick_engine()
if not eng:
    print("x\t%s\t\t\t\t\t\t\t" % empty_engine_msg())
    sys.exit(0)

# Runtime stays internal (row field eng). No docker/podman label in the UI.
seen = set()
basic = []
for name, state, image, cid in list_ps(eng):
    key = cid or name
    if not name or key in seen or name in seen:
        continue
    seen.add(key)
    seen.add(name)
    basic.append((name, state, short_image(image), cid))

if not basic:
    print("x\t(no containers)\t\t\t\t\t\t\t")
    sys.exit(0)

# One batch inspect for meta + compose graph.
names = [b[0] for b in basic]
raw = run([eng, "inspect", *names], timeout=60)
try:
    inspected = json.loads(raw) if raw else []
except Exception:
    inspected = []
if not isinstance(inspected, list):
    inspected = [inspected] if inspected else []
by_inspect = {}
for info in inspected:
    n = (info.get("Name") or "").lstrip("/")
    if n:
        by_inspect[n] = info

rows = []
for name, state, image, cid in basic:
    vol, directory, project, service, deps = meta_from_info(by_inspect.get(name))
    rows.append({
        "eng": eng,
        "name": name,
        "state": state,
        "image": image,
        "vol": vol,
        "dir": directory,
        "project": project,
        "service": service,
        "deps": deps,
    })

# Nest leaf compose deps under the service that needs them (tree UI).
svc_row = {}
for r in rows:
    if r["project"] and r["service"]:
        svc_row[(r["project"], r["service"])] = r

children = {}  # parent container name -> [child rows]
assigned = set()
for r in rows:
    if not r["project"] or not r["deps"]:
        continue
    for dep_svc in r["deps"]:
        child = svc_row.get((r["project"], dep_svc))
        if not child or child["name"] == r["name"]:
            continue
        # Only nest pure leaf deps (no outbound depends_on) once.
        if child["deps"]:
            continue
        if child["name"] in assigned:
            continue
        children.setdefault(r["name"], []).append(child)
        assigned.add(child["name"])

roots = [r for r in rows if r["name"] not in assigned]
roots.sort(key=lambda r: (0 if r["state"] == "running" else 1, r["name"].lower()))

ordered = []

def emit(r, depth):
    ordered.append((r, depth))
    kids = children.get(r["name"], [])
    kids.sort(key=lambda x: (0 if x["state"] == "running" else 1, x["name"].lower()))
    for k in kids:
        emit(k, depth + 1)

for r in roots:
    emit(r, 0)

# c eng name state image vol dir depth deps
for r, depth in ordered:
    deps_s = ",".join(r["deps"]).replace("\t", " ")
    print(
        "c\t%s\t%s\t%s\t%s\t%s\t%s\t%d\t%s"
        % (r["eng"], r["name"], r["state"], r["image"], r["vol"], r["dir"], depth, deps_s)
    )
PY
}

load_colors

TMP=$(mktemp)
list_rows >"$TMP" || { rm -f "$TMP"; echo "could not list containers" >&2; exit 1; }

types=()
engines=()
names=()
states=()
images=()
volumes=()
dirs=()
depths=()
deps=()
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  t=$(printf '%s' "$line" | cut -f1)
  e=$(printf '%s' "$line" | cut -f2)
  n=$(printf '%s' "$line" | cut -f3)
  s=$(printf '%s' "$line" | cut -f4)
  img=$(printf '%s' "$line" | cut -f5)
  vol=$(printf '%s' "$line" | cut -f6)
  d=$(printf '%s' "$line" | cut -f7)
  dep_depth=$(printf '%s' "$line" | cut -f8)
  dep_list=$(printf '%s' "$line" | cut -f9)
  [ -n "$dep_depth" ] || dep_depth=0
  types+=("$t")
  engines+=("$e")
  names+=("$n")
  states+=("$s")
  images+=("$img")
  volumes+=("$vol")
  dirs+=("$d")
  depths+=("$dep_depth")
  deps+=("$dep_list")
done <"$TMP"
rm -f "$TMP"

n=${#types[@]}
[ "$n" -gt 0 ] || { echo "nothing to show"; exit 1; }

i=0
query=""
searching=0

status=""
detail=""
status_err=0

# Parallel 0/1 flags — rows start collapsed.
expanded=()
x=0
while [ "$x" -lt "$n" ]; do
  expanded+=("0")
  x=$((x + 1))
done

short_name() {
  # dailybotplatformlocal-discordgateway-1 -> discordgateway
  printf '%s' "$1" | sed -E \
    -e 's/^dailybotplatformlocal[-_]//' \
    -e 's/^dailybot[-_]//' \
    -e 's/[-_][0-9]+$//'
}

lc() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Case-insensitive substring on name / short / state / image / volume / dir.
row_matches() {
  local idx=$1 q sn hay
  case ${types[$idx]:-} in
    c) ;;
    x|s)
      # Keep empty-state rows only when not filtering.
      [ -z "$query" ] && return 0
      return 1
      ;;
    *) return 1 ;;
  esac
  [ -z "$query" ] && return 0
  q=$(lc "$query")
  sn=$(short_name "${names[$idx]}")
  hay=$(lc "${names[$idx]} ${sn} ${states[$idx]} ${images[$idx]} ${volumes[$idx]} ${dirs[$idx]} ${deps[$idx]:-}")
  case $hay in
    *"$q"*) return 0 ;;
  esac
  return 1
}

visible_count() {
  local x=0 c=0
  while [ "$x" -lt "$n" ]; do
    if row_matches "$x"; then
      c=$((c + 1))
    fi
    x=$((x + 1))
  done
  printf '%s' "$c"
}

first_sel() {
  local x=0
  while [ "$x" -lt "$n" ]; do
    if [ "${types[$x]}" = c ] && row_matches "$x"; then
      i=$x
      return
    fi
    x=$((x + 1))
  done
  # No selectable match — park on first visible row if any.
  x=0
  while [ "$x" -lt "$n" ]; do
    if row_matches "$x"; then
      i=$x
      return
    fi
    x=$((x + 1))
  done
  i=0
}
first_sel

move() {
  local dir=$1
  local x=$i
  local steps=0
  [ "$n" -gt 0 ] || return
  while [ "$steps" -lt "$n" ]; do
    x=$((x + dir))
    if [ "$x" -lt 0 ]; then
      x=$((n - 1))
    fi
    if [ "$x" -ge "$n" ]; then
      x=0
    fi
    if [ "${types[$x]}" = c ] && row_matches "$x"; then
      i=$x
      return
    fi
    steps=$((steps + 1))
  done
}

toggle_expand() {
  case ${types[$i]:-} in
    c) ;;
    *) return ;;
  esac
  if [ "${expanded[$i]}" = 1 ]; then
    expanded[$i]=0
  else
    expanded[$i]=1
  fi
}

state_color() {
  case $1 in
    running) printf '%s' "$green" ;;
    exited|dead) printf '%s' "$red" ;;
    created|paused) printf '%s' "$yellow" ;;
    *) printf '%s' "$fg" ;;
  esac
}

# Tree prefix: roots flush; leaf deps indented with · 
tree_pref() {
  local depth=${1:-0}
  local mark=$2
  local d=0
  local pad="  "
  while [ "$d" -lt "$depth" ]; do
    pad="${pad}  "
    d=$((d + 1))
  done
  if [ -n "$mark" ] && [ "$mark" != " " ]; then
    printf '%s%s ' "$pad" "$mark"
  elif [ "$depth" -gt 0 ]; then
    printf '%s· ' "$pad"
  else
    printf '%s  ' "$pad"
  fi
}

print_name_state() {
  # $1 tree prefix (already includes mark), $2 short name, $3 state, $4 color
  local pref=$1
  local sn=$2
  local st=$3
  local nc=${4:-$fg}
  hex_fg "$nc"
  printf '\033[K%s%s (' "$pref" "$(clip "$sn")"
  hex_fg "$(state_color "$st")"
  printf '%s' "$st"
  hex_fg "$nc"
  printf ')\n'
  rst
}

draw_detail_lines() {
  local idx=$1
  local pad=$2
  local st=${states[$idx]}
  local need=${deps[$idx]:-}
  printf '\033[K%s- state: ' "$pad"
  hex_fg "$(state_color "$st")"
  printf '%s' "$st"
  rst
  printf '\n'
  hex_fg "$fg"
  if [ -n "$need" ]; then
    printf '\033[K%s- needs: %s\n' "$pad" "$(clip "$need")"
  fi
  printf '\033[K%s- image: %s\n' "$pad" "$(clip "${images[$idx]}")"
  printf '\033[K%s- volume: %s\n' "$pad" "$(clip "${volumes[$idx]}")"
  printf '\033[K%s- dir: %s\n' "$pad" "$(clip "${dirs[$idx]}")"
  rst
}

draw() {
  local x t sn mark shown=0
  if [ "$searching" = 1 ]; then
    printf '\033[?25h'
  else
    printf '\033[?25l'
  fi
  printf '\033[H\033[J'
  printf '\033[K'
  printf '  MμHerdr containers  '
  hex_fg "$accent"
  printf 'j/k'
  rst
  printf '  Enter start  '
  hex_fg "$accent"
  printf 'Space'
  rst
  printf ' expand  '
  hex_fg "$accent"
  printf '/'
  rst
  printf ' find  '
  hex_fg "$accent"
  printf 'd'
  rst
  printf ' stop  '
  hex_fg "$red"
  printf 'Esc'
  rst
  printf ' cancel\n'
  printf '\033[K'
  if [ "$searching" = 1 ]; then
    hex_fg "$accent"
    printf '  /%s█\n' "$(clip "$query")"
    rst
  elif [ -n "$status" ]; then
    if [ "$status_err" = 1 ]; then
      hex_fg "$red"
    else
      hex_fg "$accent"
    fi
    printf '  %s\n' "$(clip "$status")"
    rst
  elif [ -n "$query" ]; then
    hex_fg "$accent"
    printf '  /%s\n' "$(clip "$query")"
    rst
  else
    printf '\n'
  fi
  printf '\033[K'
  if [ "$searching" = 1 ]; then
    hex_fg "$fg"
    printf '  type to filter · Enter done · Esc clear\n'
    rst
  elif [ -n "$detail" ]; then
    hex_fg "$fg"
    printf '  %s\n' "$(clip "$detail")"
    rst
  elif [ -n "$query" ]; then
    hex_fg "$fg"
    printf '  %s match(es) · / edit · Esc clears filter\n' "$(visible_count)"
    rst
  else
    printf '\n'
  fi
  x=0
  while [ "$x" -lt "$n" ]; do
    if ! row_matches "$x"; then
      x=$((x + 1))
      continue
    fi
    shown=$((shown + 1))
    t=${types[$x]}
    printf '\033[K'
    if [ "$t" = s ]; then
      hex_fg "$accent"
      printf '  %s\n' "$(clip "${engines[$x]}")"
      rst
    elif [ "$t" = x ]; then
      hex_fg "$fg"
      printf '    %s\n' "$(clip "${engines[$x]} ${names[$x]}")"
      rst
    else
      sn=$(short_name "${names[$x]}")
      depth=${depths[$x]:-0}
      # ❯ = selected. ℹ = expanded. Deps nest under parents (compose depends_on).
      if [ "$x" -eq "$i" ] && [ "${expanded[$x]}" = 1 ]; then
        print_name_state "$(tree_pref "$depth" "ℹ")" "$sn" "${states[$x]}" "$accent"
      elif [ "$x" -eq "$i" ]; then
        print_name_state "$(tree_pref "$depth" "❯")" "$sn" "${states[$x]}" "$accent"
      elif [ "${expanded[$x]}" = 1 ]; then
        print_name_state "$(tree_pref "$depth" "ℹ")" "$sn" "${states[$x]}" "$fg"
      else
        print_name_state "$(tree_pref "$depth" " ")" "$sn" "${states[$x]}" "$fg"
      fi
      if [ "${expanded[$x]}" = 1 ]; then
        draw_detail_lines "$x" "$(tree_pref "$depth" " " | sed 's/[^ ]/ /g')  "
      fi
    fi
    x=$((x + 1))
  done
  if [ "$shown" -eq 0 ]; then
    printf '\033[K'
    hex_fg "$fg"
    if [ -n "$query" ]; then
      printf '    (no containers match /%s)\n' "$(clip "$query")"
    else
      printf '    (no containers)\n'
    fi
    rst
  fi
  printf '\033[J'
}

# Live filter prompt after /. Enter keeps query; Esc clears it.
do_search() {
  local k c seq
  searching=1
  status=""
  detail=""
  status_err=0
  while true; do
    first_sel
    draw
    IFS= read -r -n 1 k || break
    # Enter finishes search and keeps the filter.
    if [ -z "$k" ] || [ "$k" = "$(printf '\n')" ] || [ "$k" = "$(printf '\r')" ]; then
      break
    fi
    # Backspace / Delete.
    if [ "$k" = "$(printf '\177')" ] || [ "$k" = "$(printf '\b')" ]; then
      query=${query%?}
      continue
    fi
    # Esc: bare = clear filter; CSI arrows ignored while typing.
    if [ "$k" = "$(printf '\033')" ]; then
      seq=""
      if IFS= read -r -n 1 -t 0.05 c; then
        seq=$c
        if [ "$c" = '[' ]; then
          while IFS= read -r -n 1 -t 0.05 c; do
            seq="${seq}${c}"
            case $c in
              A|B|C|D|u|'~'|z|Z) break ;;
            esac
            [ ${#seq} -gt 30 ] && break
          done
        fi
        continue
      fi
      query=""
      break
    fi
    # Printable ASCII only (skip control chars).
    case $k in
      [[:cntrl:]]) continue ;;
    esac
    query="${query}${k}"
  done
  searching=0
  first_sel
  if [ -n "$query" ]; then
    status=""
    detail=""
    status_err=0
  else
    status=""
    detail=""
    status_err=0
  fi
  printf '\033[?25l'
}

# Sets ACTION: enter | expand | stop | search | up | down | quit | none
read_action() {
  local k c seq
  ACTION=none
  IFS= read -r -n 1 k || { ACTION=quit; return; }
  case $k in
    j) ACTION=down; return ;;
    k) ACTION=up; return ;;
    q) ACTION=quit; return ;;
    d) ACTION=stop; return ;;
    /) ACTION=search; return ;;
    ' ') ACTION=expand; return ;;
  esac
  if [ -z "$k" ] || [ "$k" = "$(printf '\n')" ] || [ "$k" = "$(printf '\r')" ]; then
    ACTION=enter
    return
  fi
  if [ "$k" != "$(printf '\033')" ]; then
    ACTION=none
    return
  fi
  # Escape sequence (arrows / bare Esc).
  seq=""
  if IFS= read -r -n 1 -t 1 c; then
    seq=$c
    if [ "$c" = '[' ]; then
      while IFS= read -r -n 1 -t 1 c; do
        seq="${seq}${c}"
        case $c in
          A) ACTION=up; return ;;
          B) ACTION=down; return ;;
          u|'~'|z|Z) break ;;
        esac
        [ ${#seq} -gt 30 ] && break
      done
    fi
  else
    # Bare Esc: clear active filter first, else quit.
    if [ -n "$query" ]; then
      query=""
      first_sel
      status=""
      detail=""
      status_err=0
      ACTION=none
      return
    fi
    ACTION=quit
    return
  fi
  if [ -z "$seq" ] || [ "$seq" = '[' ]; then
    if [ -n "$query" ]; then
      query=""
      first_sel
      status=""
      detail=""
      status_err=0
      ACTION=none
    else
      ACTION=quit
    fi
  else
    ACTION=none
  fi
}

show_fail() {
  local title=$1
  local body=$2
  ctr_log "fail ui: $title | $body"
  printf '\033[?25h\033[H\033[J'
  hex_fg "$red"
  printf '\n  X  %s\n\n' "$title"
  rst
  hex_fg "$fg"
  printf '%s\n' "$body" | fold -s -w $((maxw > 20 ? maxw : 40)) | sed 's/^/  /'
  printf '\n'
  rst
  printf '  Press any key to go back...\n'
  IFS= read -r -n 1 _ || true
  status=""
  detail=""
  status_err=0
  printf '\033[?25l\033[H\033[J'
}

parse_root_pane() {
  python3 -c '
import json, sys
d = json.load(sys.stdin)
print(((d.get("result") or {}).get("root_pane") or {}).get("pane_id") or "")
'
}

is_running() {
  local eng=$1
  local name=$2
  local st
  # docker + podman both expose State.Running; fall back to Status.
  st=$("$eng" inspect -f '{{.State.Running}}' "$name" 2>/dev/null) || return 1
  case $st in
    true|True|TRUE|1) return 0 ;;
  esac
  st=$("$eng" inspect -f '{{.State.Status}}' "$name" 2>/dev/null) || return 1
  case $st in
    running|Running) return 0 ;;
  esac
  return 1
}

# Mark a container row as $2 state in the on-screen list (by full name).
mark_state() {
  local name=$1
  local st=$2
  local x=0
  while [ "$x" -lt "$n" ]; do
    if [ "${types[$x]:-}" = c ] && [ "${names[$x]}" = "$name" ]; then
      states[$x]=$st
    fi
    x=$((x + 1))
  done
}

# Compose/Podman depends_on → start order (deps first, target last). One name per line.
# No compose labels → just the target.
resolve_start_order() {
  local eng=$1
  local target=$2
  python3 - "$eng" "$target" <<'PY'
import json, subprocess, sys

eng, target = sys.argv[1], sys.argv[2]

def run(cmd, timeout=20):
    try:
        return subprocess.check_output(
            cmd, text=True, stderr=subprocess.DEVNULL, timeout=timeout
        )
    except Exception:
        return ""

def parse_depends(raw):
    # "postgres:service_started:false,redis:service_started:false"
    out = []
    seen = set()
    for part in (raw or "").split(","):
        part = part.strip()
        if not part:
            continue
        svc = part.split(":", 1)[0].strip()
        if svc and svc not in seen:
            seen.add(svc)
            out.append(svc)
    return out

def labels_of(info):
    return ((info.get("Config") or {}).get("Labels")) or {}

def project_of(labels):
    return (
        labels.get("com.docker.compose.project")
        or labels.get("io.podman.compose.project")
        or labels.get("com.docker.compose.project.name")
        or ""
    )

def service_of(labels):
    return (
        labels.get("com.docker.compose.service")
        or labels.get("io.podman.compose.service")
        or ""
    )

def depends_of(labels):
    return parse_depends(
        labels.get("com.docker.compose.depends_on")
        or labels.get("io.podman.compose.depends_on")
        or ""
    )

names_out = run([eng, "ps", "-a", "--format", "{{.Names}}"])
names = []
for line in names_out.splitlines():
    for part in line.split(","):
        n = part.strip().lstrip("/")
        if n:
            names.append(n)
if target not in names:
    names.append(target)
if not names:
    print(target)
    raise SystemExit(0)

raw = run([eng, "inspect", *names], timeout=60)
try:
    data = json.loads(raw) if raw else []
except Exception:
    data = []
if not isinstance(data, list):
    data = [data] if data else []

index = {}
by_ps = {}
for info in data:
    name = (info.get("Name") or "").lstrip("/")
    if not name:
        continue
    labels = labels_of(info)
    project = project_of(labels)
    service = service_of(labels)
    deps = depends_of(labels)
    index[name] = {"project": project, "service": service, "deps": deps}
    if project and service:
        by_ps.setdefault((project, service), []).append(name)

if target not in index:
    print(target)
    raise SystemExit(0)

order = []
stack = set()
done = set()

def visit(name):
    if name in done or name in stack:
        return
    stack.add(name)
    info = index.get(name) or {}
    project = info.get("project") or ""
    for dep_svc in info.get("deps") or []:
        if not project:
            break
        for dep_name in by_ps.get((project, dep_svc), []):
            visit(dep_name)
    stack.discard(name)
    done.add(name)
    order.append(name)

visit(target)
if target not in order:
    order.append(target)
for n in order:
    print(n)
PY
}

# Wait until runtime reports running (exec needs a live PID 1).
wait_running() {
  local eng=$1
  local name=$2
  local tries=0
  while [ "$tries" -lt 20 ]; do
    if is_running "$eng" "$name"; then
      mark_state "$name" running
      return 0
    fi
    sleep 0.25
    tries=$((tries + 1))
  done
  return 1
}

start_container() {
  local eng=$1
  local name=$2
  local errfile rc
  errfile=$(mktemp)
  ctr_log "start begin eng=$eng name=$name"
  if is_running "$eng" "$name"; then
    rm -f "$errfile"
    ctr_log "already running name=$name"
    mark_state "$name" running
    return 0
  fi
  "$eng" start "$name" >"$errfile" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    start_err=$(tr '\n' ' ' <"$errfile" | sed 's/[[:space:]]*$//')
    rm -f "$errfile"
    [ -n "$start_err" ] || start_err="start failed (exit $rc)"
    ctr_log "start fail name=$name err=$start_err"
    return 1
  fi
  rm -f "$errfile"
  if wait_running "$eng" "$name"; then
    ctr_log "start ok name=$name"
    return 0
  fi
  start_err="started but not running yet"
  ctr_log "start timeout name=$name"
  return 1
}

# Restart a running container (docker/podman restart). Used on Enter when already up.
restart_container() {
  local eng=$1
  local name=$2
  local errfile rc
  errfile=$(mktemp)
  ctr_log "restart begin eng=$eng name=$name"
  "$eng" restart "$name" >"$errfile" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    start_err=$(tr '\n' ' ' <"$errfile" | sed 's/[[:space:]]*$//')
    rm -f "$errfile"
    [ -n "$start_err" ] || start_err="restart failed (exit $rc)"
    ctr_log "restart fail name=$name err=$start_err"
    return 1
  fi
  rm -f "$errfile"
  if wait_running "$eng" "$name"; then
    ctr_log "restart ok name=$name"
    return 0
  fi
  start_err="restarted but not running yet"
  ctr_log "restart timeout name=$name"
  return 1
}

# Ensure $name is up: start if stopped, restart if already running.
# Deps only start when down (never restart siblings).
start_or_restart() {
  local eng=$1
  local name=$2
  if is_running "$eng" "$name"; then
    restart_container "$eng" "$name"
  else
    start_container "$eng" "$name"
  fi
}

# Start compose depends_on chain (deps first), then start/restart $name.
start_with_deps() {
  local eng=$1
  local name=$2
  local order dep sn_dep dep_list=()
  local count=0 total=0
  start_err=""
  order=$(resolve_start_order "$eng" "$name") || order=$name
  while IFS= read -r dep || [ -n "$dep" ]; do
    [ -z "$dep" ] && continue
    dep_list+=("$dep")
  done <<EOF
$order
EOF
  total=${#dep_list[@]}
  [ "$total" -gt 0 ] || dep_list=("$name")
  total=${#dep_list[@]}
  ctr_log "start order n=$total target=$name :: ${dep_list[*]}"
  count=0
  for dep in "${dep_list[@]}"; do
    count=$((count + 1))
    sn_dep=$(short_name "$dep")
    if [ "$dep" = "$name" ]; then
      if is_running "$eng" "$name"; then
        status="restarting ${sn_dep}..."
        detail="Enter on running · restart"
      else
        status="starting ${sn_dep}..."
        if [ "$total" -gt 1 ]; then
          detail="deps up · ${count}/${total}"
        else
          detail="start ${dep}"
        fi
      fi
      status_err=0
      draw
      if ! start_or_restart "$eng" "$dep"; then
        return 1
      fi
    else
      status="starting dep ${sn_dep}..."
      detail="${count}/${total} · need for $(short_name "$name")"
      status_err=0
      draw
      if ! start_container "$eng" "$dep"; then
        start_err="dep ${sn_dep}: ${start_err}"
        ctr_log "dep fail name=$dep err=$start_err"
        return 1
      fi
    fi
  done
  return 0
}

stop_container() {
  local eng=$1
  local name=$2
  local errfile rc tries
  errfile=$(mktemp)
  ctr_log "stop begin eng=$eng name=$name"
  if ! is_running "$eng" "$name"; then
    rm -f "$errfile"
    ctr_log "already stopped name=$name"
    return 0
  fi
  "$eng" stop "$name" >"$errfile" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    stop_err=$(tr '\n' ' ' <"$errfile" | sed 's/[[:space:]]*$//')
    rm -f "$errfile"
    [ -n "$stop_err" ] || stop_err="stop failed (exit $rc)"
    ctr_log "stop fail name=$name err=$stop_err"
    return 1
  fi
  rm -f "$errfile"
  tries=0
  while [ "$tries" -lt 20 ]; do
    if ! is_running "$eng" "$name"; then
      ctr_log "stop ok name=$name"
      return 0
    fi
    sleep 0.25
    tries=$((tries + 1))
  done
  stop_err="stop issued but still running"
  ctr_log "stop timeout name=$name"
  return 1
}

remove_container() {
  local eng=$1
  local name=$2
  local errfile rc
  errfile=$(mktemp)
  ctr_log "rm begin eng=$eng name=$name"
  # Force remove so a stuck container can still be dropped.
  "$eng" rm -f "$name" >"$errfile" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ]; then
    stop_err=$(tr '\n' ' ' <"$errfile" | sed 's/[[:space:]]*$//')
    rm -f "$errfile"
    [ -n "$stop_err" ] || stop_err="rm failed (exit $rc)"
    ctr_log "rm fail name=$name err=$stop_err"
    return 1
  fi
  rm -f "$errfile"
  ctr_log "rm ok name=$name"
  return 0
}

# Drop row $1 from parallel arrays (types/names/…/expanded/depths/deps).
drop_row() {
  local idx=$1
  local x
  local nt=() ne=() nn=() ns=() ni=() nv=() nd=() nx=() ndp=() nde=()
  x=0
  while [ "$x" -lt "$n" ]; do
    if [ "$x" -ne "$idx" ]; then
      nt+=("${types[$x]}")
      ne+=("${engines[$x]}")
      nn+=("${names[$x]}")
      ns+=("${states[$x]}")
      ni+=("${images[$x]}")
      nv+=("${volumes[$x]}")
      nd+=("${dirs[$x]}")
      nx+=("${expanded[$x]:-0}")
      ndp+=("${depths[$x]:-0}")
      nde+=("${deps[$x]:-}")
    fi
    x=$((x + 1))
  done
  types=("${nt[@]}")
  engines=("${ne[@]}")
  names=("${nn[@]}")
  states=("${ns[@]}")
  images=("${ni[@]}")
  volumes=("${nv[@]}")
  dirs=("${nd[@]}")
  expanded=("${nx[@]}")
  depths=("${ndp[@]}")
  deps=("${nde[@]}")
  n=${#types[@]}
  if [ "$n" -le 0 ]; then
    i=0
    types=("x")
    engines=("(no containers left)")
    names=("")
    states=("")
    images=("")
    volumes=("")
    dirs=("")
    expanded=("0")
    depths=("0")
    deps=("")
    n=1
    i=0
    return
  fi
  if [ "$i" -ge "$n" ]; then
    i=$((n - 1))
  fi
  case ${types[$i]:-} in
    c) ;;
    *) first_sel ;;
  esac
}

do_stop() {
  local t=${types[$i]}
  local eng=${engines[$i]}
  local name=${names[$i]}
  local sn ans running=0
  local action=stop
  stop_err=""
  case $t in
    c) ;;
    *)
      status="select a container first"
      detail="j/k then d to stop"
      status_err=1
      return
      ;;
  esac
  sn=$(short_name "$name")
  if is_running "$eng" "$name"; then
    running=1
    action=stop
  else
    action=remove
  fi
  ctr_log "stop ask name=$name action=$action"
  printf '\033[?25h\033[H\033[J'
  hex_fg "$red"
  if [ "$action" = stop ]; then
    printf '\n  Stop container?\n\n'
  else
    printf '\n  Remove stopped container?\n\n'
  fi
  rst
  printf '  name:  %s\n' "$sn"
  printf '  full:  %s\n' "$name"
  printf '  state: %s\n\n' "${states[$i]}"
  if [ "$action" = stop ]; then
    printf '  [y] stop   [c] cancel\n'
  else
    printf '  [y] remove   [c] cancel\n'
  fi
  ans=
  IFS= read -r -n 1 ans || ans=c
  printf '\033[?25l'
  case $ans in
    y|Y)
      status="stopping ${sn}..."
      detail=""
      status_err=0
      if [ "$action" = stop ]; then
        draw
        if stop_container "$eng" "$name"; then
          states[$i]=exited
          status="stopped ${sn}"
          detail="Enter starts again · d removes when stopped"
          status_err=0
        else
          show_fail "could not stop ${sn}" "${stop_err}"
        fi
      else
        status="removing ${sn}..."
        draw
        if remove_container "$eng" "$name"; then
          status="removed ${sn}"
          detail=""
          status_err=0
          drop_row "$i"
        else
          show_fail "could not remove ${sn}" "${stop_err}"
        fi
      fi
      ;;
    *)
      status=""
      detail=""
      status_err=0
      ;;
  esac
}

open_container_workspace() {
  local eng=$1
  local name=$2
  local label sn json pane err
  sn=$(short_name "$name")
  label=$sn
  err=$(mktemp)
  json=$("$HERDR_BIN" workspace create --label "$label" --focus 2>"$err") || {
    open_err=$(tr '\n' ' ' <"$err" | sed 's/[[:space:]]*$//')
    rm -f "$err"
    [ -n "$open_err" ] || open_err="herdr workspace create failed"
    ctr_log "workspace create fail name=$name err=$open_err"
    return 1
  }
  rm -f "$err"
  pane=$(printf '%s' "$json" | parse_root_pane)
  [ -n "$pane" ] || {
    open_err="no root pane in workspace create response"
    ctr_log "no root pane name=$name"
    return 1
  }
  # Pane title is the container name only — no docker/podman leak.
  "$HERDR_BIN" pane rename "$pane" "$sn" >/dev/null 2>&1 || true
  # Prefer bash; fall back to sh. Same flags work on docker and podman.
  local attempt=0
  while [ "$attempt" -lt 6 ]; do
    if "$HERDR_BIN" pane run "$pane" "$eng" exec -it "$name" \
      sh -c 'exec bash 2>/dev/null || exec sh' >/dev/null 2>&1; then
      ctr_log "opened workspace eng=$eng name=$name pane=$pane"
      return 0
    fi
    sleep 0.4
    attempt=$((attempt + 1))
  done
  open_err="could not exec into ${name} (entrypoint blocking TTY?)"
  ctr_log "exec fail eng=$eng name=$name pane=$pane"
  return 1
}

do_enter() {
  local t=${types[$i]}
  local eng=${engines[$i]}
  local name=${names[$i]}
  local state=${states[$i]}
  local sn
  start_err=""
  open_err=""
  case $t in
    c) ;;
    *) return ;;
  esac
  sn=$(short_name "$name")
  ctr_log "enter eng=$eng name=$name state=$state"
  if [ "$state" = running ] || is_running "$eng" "$name"; then
    status="restarting ${sn}..."
    detail="running → restart + deps"
  else
    status="resolving deps for ${sn}..."
    detail="compose depends_on"
  fi
  status_err=0
  draw
  # Deps start if down; target starts if down, restarts if already running.
  if ! start_with_deps "$eng" "$name"; then
    show_fail \
      "could not start ${sn}" \
      "${start_err}. Is the container runtime running?"
    return
  fi
  states[$i]=running
  mark_state "$name" running
  status="opening shell in ${sn}..."
  detail="workspace + shell"
  status_err=0
  draw
  if ! open_container_workspace "$eng" "$name"; then
    show_fail \
      "container ${sn} is up, but shell failed" \
      "${open_err}"
    return
  fi
  ctr_log "done name=$name"
  exit 0
}

ctr_log "start n=$n bin=$HERDR_BIN"

while true; do
  draw
  read_action
  case $ACTION in
    down) move 1 ;;
    up) move -1 ;;
    quit) exit 0 ;;
    expand) toggle_expand ;;
    stop) do_stop ;;
    search) do_search ;;
    enter) do_enter ;;
  esac
done
