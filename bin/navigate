#!/usr/bin/env bash
# Stay in navigate mode until Esc. hjkl move panes, 1-9 switch tabs.
set -u
printf '\033]0;Navigate\007\033]2;Navigate\007'

HERDR_BIN=${HERDR_BIN_PATH:-herdr}
PANE=${HERDR_ACTIVE_PANE_ID:-}
HERE=$(cd "$(dirname "$0")/.." && pwd)
CONF="${HERDR_CONFIG_PATH:-${HOME:-}/.config/herdr/config.toml}"
CONF_DIR=$(dirname "$CONF")
THEMES="$HERE/themes"
[ -d "$THEMES" ] || THEMES="$CONF_DIR/themes"
accent="#84FFFF"
red="#F07178"

load_colors() {
  local pal="$THEMES/deep-ocean.toml"
  [ -f "$THEMES/active" ] && pal="$THEMES/$(tr -d '[:space:]' <"$THEMES/active").toml"
  [ -f "$pal" ] || return 0
  while IFS='=' read -r k v || [ -n "${k:-}" ]; do
    k=$(printf '%s' "$k" | tr -d '[:space:]')
    v=$(printf '%s' "$v" | tr -d '[:space:]' | tr -d '"')
    case $k in
      accent) accent=$v ;;
      red) red=$v ;;
    esac
  done <"$pal"
}

hex_fg() {
  local h=${1#\#}
  [ ${#h} -eq 6 ] || return 0
  printf '\033[38;2;%d;%d;%dm' $((0x${h:0:2})) $((0x${h:2:2})) $((0x${h:4:2}))
}

rst() { printf '\033[0m'; }

save_tty=$(stty -g 2>/dev/null) || save_tty=
stty -echo -icanon 2>/dev/null || true
trap 'printf "\033[?25h"; [ -n "$save_tty" ] && stty "$save_tty"' EXIT

focused_pane() {
  python3 -c '
import json, os, subprocess, sys
bin = os.environ.get("HERDR_BIN_PATH", "herdr")
try:
    raw = subprocess.check_output([bin, "pane", "list"], text=True)
    panes = json.loads(raw).get("result", {}).get("panes") or json.loads(raw).get("result") or []
    if isinstance(panes, dict):
        panes = panes.get("panes") or []
    for p in panes:
        if p.get("focused"):
            print(p.get("pane_id") or "")
            sys.exit(0)
except Exception:
    pass
print(os.environ.get("HERDR_ACTIVE_PANE_ID") or "")
'
}

focus_dir() {
  local dir=$1
  if [ -n "$PANE" ]; then
    "$HERDR_BIN" pane focus --pane "$PANE" --direction "$dir" >/dev/null 2>&1 || true
  else
    "$HERDR_BIN" pane focus --current --direction "$dir" >/dev/null 2>&1 || true
  fi
  PANE=$(focused_pane)
}

focus_tab_n() {
  local n=$1
  python3 -c '
import json, os, subprocess, sys
bin = os.environ.get("HERDR_BIN_PATH", "herdr")
want = int(sys.argv[1])
raw = subprocess.check_output([bin, "tab", "list"], text=True)
tabs = json.loads(raw)["result"]["tabs"]
# Prefer explicit number, else 1-based order
by_num = {int(t.get("number") or 0): t for t in tabs}
t = by_num.get(want)
if t is None and 1 <= want <= len(tabs):
    t = tabs[want - 1]
if t and t.get("tab_id"):
    subprocess.call([bin, "tab", "focus", t["tab_id"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
' "$n"
}

status=""

draw() {
  printf '\033[?25l\033[H'
  printf '\033[K'
  printf '  Navigate  '
  hex_fg "$accent"
  printf 'h/j/k/l'
  rst
  printf ' panes  '
  hex_fg "$accent"
  printf '1-9'
  rst
  printf ' tabs  '
  hex_fg "$red"
  printf 'Esc'
  rst
  printf ' / q exit\n'
  printf '\033[K'
  if [ -n "$status" ]; then
    printf '  %s\n' "$status"
  else
    printf '  (stays until Esc or q)\n'
  fi
  printf '\033[J'
}

load_colors
PANE=$(focused_pane)

while true; do
  draw
  IFS= read -r -n 1 key || key=
  status=""
  case $key in
    h) focus_dir left ;;
    j) focus_dir down ;;
    k) focus_dir up ;;
    l) focus_dir right ;;
    1|2|3|4|5|6|7|8|9) focus_tab_n "$key" ;;
    $'\n'|$'\r') ;;
    $'\033'|q) exit 0 ;;
  esac
done
