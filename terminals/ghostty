# MμHerdr — put this in ~/.config/ghostty/config
# iTerm2 cannot send Shift-Space. Ghostty can, by turning it into Ctrl-B,
# which is the prefix Herdr actually reads.
#
# brew install --cask ghostty
# Reload Ghostty: Cmd-Shift-,
# Run `herdr` inside Ghostty, not iTerm.

keybind = shift+space=text:\x02
